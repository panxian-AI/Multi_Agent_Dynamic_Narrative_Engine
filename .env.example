# 仅 CLI / 开发使用；桌面 EXE 请使用「API 配置」窗口（Key 存在本机用户目录）。
# 真实 LLM 接入（DeepSeek，OpenAI 兼容接口）
# 填入你的 DeepSeek API Key 后，MADNE_MOCK 设为 0
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192

# 0 = 使用真实模型；1 = 强制 Mock；不设置时：有 API Key 则用真实模型，否则自动回退 Mock
MADNE_MOCK=0
MADNE_DATA_DIR=runtime

# 每 N 个记忆事件触发一次压缩
MADNE_MEMORY_COMPRESS_EVERY=10
# 是否预取未来两层选项（1=开启，0=关闭）
MADNE_PREFETCH_CHOICES=1
# Guardian 审查失败后的最大重写次数
MADNE_REVIEW_MAX_REWRITES=2

# ===== 图像生成（diffusers（默认，本地 SD） / mock / ark / comfyui）=====
# 本地 SD 为默认路径；只有显式选择在线 API 时才会使用 API Key。
# IMG_ENABLED=0 可完全关闭插图生成
IMG_ENABLED=1
# 本地 SD 模型生成（无需外部生图 API）
IMG_BACKEND=diffusers
# 单张图片生成上限（秒）
IMG_TIMEOUT=60
IMG_WIDTH=512
IMG_HEIGHT=512
IMG_STEPS=4
IMG_GUIDANCE=0
# self_attn：固定 seed + 稳定外观提示；id_injection：使用角色定妆照注入身份
IMG_CONSISTENCY_MODE=self_attn
# 1 = 生成后用 CLIP-I / DINO 计算人物一致性（需 open_clip / dinov2）
IMG_METRICS=0

# --- 可选：Seedream / 豆包 / OpenAI 兼容图像接口 ---
# 桌面版请在「API 配置」窗口的“生图 API”区域填写；
# 打包后的 exe 不读取 .env，只读取 exe 同目录 config/config.json。
# 切换到方舟 API 时取消下一行注释：
# IMG_BACKEND=ark
# 火山方舟也接受 ARK_API_KEY / ARK_BASE_URL / ARK_IMAGE_MODEL / ARK_IMAGE_SIZE
IMG_API_KEY=
# 火山方舟默认地址：https://ark.cn-beijing.volces.com/api/v3
IMG_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMG_API_MODEL=doubao-seedream-4-0-250828
# 可选：尺寸档位（例如 2K / 4K）；留空则使用 IMG_WIDTH×IMG_HEIGHT
IMG_API_SIZE=2K
# 所有后端的单张上限统一由 IMG_TIMEOUT 控制；以下为兼容旧配置项
IMG_API_TIMEOUT=60
IMG_API_RETRIES=2
# 火山方舟专用参数
IMG_API_WATERMARK=1
IMG_API_SEQUENTIAL=disabled
IMG_API_STREAM=0

# --- 选项 A：ComfyUI（实例需预装工作流所需节点；InstantID 用自定义工作流）---
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# 支持占位符：{{PROMPT}} {{NEGATIVE_PROMPT}} {{SEED}} {{WIDTH}} {{HEIGHT}}
# {{STEPS}} {{GUIDANCE}} {{CHECKPOINT}} {{REFERENCE_IMAGE}}
# COMFYUI_WORKFLOW=./comfyui/instantid_workflow.json
# 兼容旧配置；实际使用 IMG_TIMEOUT
COMFYUI_TIMEOUT=60

# --- 选项 B：diffusers 本地 GPU（默认路径）---
# 首次运行会自动下载模型到 MODEL_CACHE_DIR，加载时间不计入 IMG_TIMEOUT
MODEL_CACHE_DIR=./models
# 默认轻量快速模型（约 2.5GB，512x512，4 步）
IMG_MODEL=stabilityai/sd-turbo
IMG_ALLOW_CPU=0
# 显存充足且需要更高画质时可改用 SDXL（约 7GB）：
# IMG_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# IMG_WIDTH=1024
# IMG_HEIGHT=768
# IMG_STEPS=28
# IMG_GUIDANCE=5
# 国内网络访问 Hugging Face 较慢/失败时：
# 1) 不配置也会自动回退 hf-mirror.com；
# 2) 也可显式固定镜像（配置后不再尝试官方站点）
# MADNE_HF_ENDPOINT=https://hf-mirror.com
# 3) 提前下载权重（只拉必要文件，支持断点续传）:
#    madne models download --mirror
# 镜像可能把权重重定向到 Xet CAS，慢速链路易读超时；
# 下载器默认已把读超时放宽到 120 秒，可按需覆盖：
# HF_HUB_DOWNLOAD_TIMEOUT=120
# IP-Adapter 权重目录（id_injection 模式使用）
# IMG_IP_ADAPTER_DIR=./models/ip-adapter

# ===== 可选：REST / 静态资源 =====
# API_TOKEN=dev-token
